{
  "realm": "idenova",
  "enabled": true,
  "displayName": "Idenova",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "REVIEWER",
        "description": "Review identity documents and verifications"
      },
      {
        "name": "ADMIN",
        "description": "Manage the Idenova platform"
      }
    ]
  },
  "clients": [
    {
      "clientId": "idenova-api",
      "name": "Idenova API",
      "rootUrl": "",
      "baseUrl": "",
